<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="category_inventory_access" model="ir.module.category">
    <field name="name">AR - Inventaire général</field>
  </record>
  <record id="privilege_settings_menu" model="res.groups.privilege">
    <field name="name">Visibilité du menu Paramètres</field>
    <field name="category_id" ref="category_inventory_access"/>
  </record>
  <record id="group_show_settings_menu" model="res.groups">
    <field name="name">Afficher le menu Paramètres</field>
    <field name="privilege_id" ref="privilege_settings_menu"/>
    <field name="comment">Contrôle uniquement la visibilité du menu Paramètres. Ne donne aucun droit supplémentaire de création, modification ou suppression.</field>
  </record>
</odoo>

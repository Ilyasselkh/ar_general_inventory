            </list>
        </field>
    </record>
    <record id="view_araymond_inventory_tree" model="ir.ui.view">
        <field name="name">araymond.lxo3.tree</field>
        <field name="model">araymond.lxo3</field>
        <field name="arch" type="xml">
            <list>
                <field name="session_id" />
                <field name="type_magasin" />
                <field name="emplacement" />
                <field name="article" />
                <field name="lot" />
                <field name="stock_total" />
                <field name="unite_qty_base" />
                <field name="type_unite_stock" />
                <field name="magasin" />
                <field name="su" />
            </list>
        </field>
    </record>
    <record id="action_araymond_inventory" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.maininvsession</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_araymond_inventory_sessionsN_tree" />
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_araymond_inventory_sessionsN_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_araymond_inventory_parametres_main_form')})]" />
    </record>
    <record id="action_araymond_inventory_etiquettes" model="ir.actions.act_window">
        <field name="name">Etiquettes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.etiquette</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_araymond_inventory_lx03" model="ir.actions.act_window">
        <field name="name">Lx03</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.lxo3</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_araymond_scan_inventory" model="ir.actions.act_window">
        <field name="name">Scan par équipes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.invsession</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'Fermeture'), ('statusSession', '=', True)]</field>
    </record>
    <record id="action_araymond_scanCloture_inventory" model="ir.actions.act_window">
        <field name="name">Cloturé</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.invsession</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_araymond_inventory_session_tree" />
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_araymond_inventory_session_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_araymond_inventory_session_form')})]" />
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="domain">[('state', '=', 'Fermeture'), ('statusSession', '=', True)]</field>
    </record>
    <record id="action_araymond_scanInactive_inventory" model="ir.actions.act_window">
        <field name="name">Inactive</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.invsession</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('statusSession', '=', False)]</field>
    </record>
    <record id="action_araymond_scanA_inventory" model="ir.actions.act_window">
        <field name="name">Anomalies</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('EmpAnomaly', '=', True)]</field>
    </record>
    <record id="action_araymond_inventory_parametres" model="ir.actions.act_window">
        <field name="name">References</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.ref</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_araymond_inventory_image" model="ir.actions.act_window">
        <field name="name">Image de stock</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.imagestock</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_araymond_inventory_parametres_ref" model="ir.actions.act_window">
        <field name="name">References</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">araymond.ref</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_inventory" name="Sessions" parent="menu_araymond_root" action="action_araymond_inventory" groups="base.group_system" sequence="20" />
    <menuitem id="menu_inventory_scan" name="Scan" parent="menu_araymond_root" action="action_araymond_scan_inventory" sequence="20" />
    <menuitem id="menu_inventory_scanCloture" name="Cloturé" parent="menu_araymond_root" action="action_araymond_scanCloture_inventory" sequence="20" />
    <menuitem id="menu_inventory_scanInactive" name="Inactive" parent="menu_araymond_root" action="action_araymond_scanInactive_inventory" sequence="20" />
    <menuitem id="menu_inventory_scanAno" name="Anomalies" parent="menu_araymond_root" action="action_araymond_scanA_inventory" sequence="20" />
    <menuitem id="menu_references" name="Reference" parent="menu_araymond_root" action="action_araymond_inventory_parametres" groups="base.group_system" sequence="30" />
    <menuitem id="menu_image" name="Image Stock" parent="menu_araymond_root" action="action_araymond_inventory_image" groups="base.group_system" sequence="30" />
    <menuitem id="menu_galia" name="Etiquettes" parent="menu_araymond_root" action="action_araymond_inventory_etiquettes" groups="base.group_system" sequence="30" />
    <menuitem id="menu_lxo3" name="LX03" parent="menu_araymond_root" groups="base.group_system" action="action_araymond_inventory_lx03" sequence="30" />
</odoo>

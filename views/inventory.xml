                <field name="rack" />
                <field name="magasinSAP" />
                <field name="nbrEmp" />
                <field name="statusSession" />
            </list>
        </field>
    </record>
    <record id="view_araymond_etiquette_tree" model="ir.ui.view">
        <field name="name">araymond.etiquette.tree</field>
        <field name="model">araymond.etiquette</field>
        <field name="arch" type="xml">
            <list>
                <field name="su" />
                <field name="ref" />
                <field name="of" />
                <field name="lot" />
                <field name="hu" />
                <field name="mode" />
                <field name="typedegalia" />
                <field name="qty" />
                <field name="branch_id" />
                <field name="count_phase" />
            </list>
        </field>
    </record>
    <record id="view_araymond_inventory_parametres_ref_form" model="ir.ui.view">
        <field name="name">araymond.ref.form</field>
        <field name="model">araymond.ref</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="reference" />
                    <field name="desc" />
                    <field name="UniteM" />
                    <field name="uc" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_araymond_inventory_parametres_ref_tree" model="ir.ui.view">
        <field name="name">araymond.ref.tree</field>
        <field name="model">araymond.ref</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference" />
                <field name="desc" />
                <field name="UniteM" />
                <field name="uc" />
            </list>
        </field>
    </record>
    <record id="view_araymond_inventory_imagestock" model="ir.ui.view">
        <field name="name">araymond.imagestock.tree</field>
        <field name="model">araymond.imagestock</field>
        <field name="arch" type="xml">
            <list>
                <field name="typemagasin" />
                <field name="emplacement" />
                <field name="reference" />
                <field name="lot" />
                <field name="stocktotal" />
                <field name="UniteM" />
                <field name="magasin" />
                <field name="emplVide" />

<odoo>
  <record id="scan_location_wizard_form" model="ir.ui.view">
    <field name="name">scan.location.wizard.form</field>
    <field name="model">araymond.scan.location.wizard</field>
    <field name="arch" type="xml">
      <form string="Nouvel emplacement">
        <group>
          <field name="session_id" invisible="1"/>
          <field name="team_ids" invisible="1"/>
          <field name="rack" string="Rack"/>
          <field name="team_id" domain="[('id', 'in', team_ids)]" options="{'no_create': True, 'no_open': True}"/>
        </group>
        <p>Créez la ligne, puis cliquez sur Scanner pour scanner le code emplacement en premier.</p>
        <footer><button name="action_create_location" type="object" string="Créer la ligne" class="btn-primary"/><button special="cancel" string="Annuler"/></footer>
      </form>
    </field>
  </record>
</odoo>
